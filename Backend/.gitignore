# ============================================================
#  Backend .gitignore
#  Node.js + Express + MongoDB project
# ============================================================

# --- Environment variables (NEVER commit these) ---
.env
.env.*
.env.local
.env.development
.env.production
!.env.example          # allow a sample/template env file

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs ---
logs/
*.log

# --- Runtime / OS ---
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- IDE ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- Build output ---
dist/
build/
