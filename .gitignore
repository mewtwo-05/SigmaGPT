# ============================================================
#  Root .gitignore  —  SigmaGPT monorepo
# ============================================================

# --- CRITICAL: Environment variables ---
**/.env
**/.env.*
**/.env.local
**/.env.development
**/.env.production
!**/.env.example

# --- Dependencies ---
**/node_modules/

# --- Logs ---
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- Build output ---
**/dist/
**/build/
**/.vite/
